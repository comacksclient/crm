generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String?
  image        String?
  role         Role      @default(SDR)
  team_id      String?
  team         Team?     @relation(fields: [team_id], references: [id])
  lastActiveAt DateTime?
  lastLoginAt  DateTime?
  logs         CallLog[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Team {
  id        String       @id @default(uuid())
  name      String       @unique
  users     User[]
  leads     Lead[]
  invites   TeamInvite[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model TeamInvite {
  id        String   @id @default(uuid())
  team_id   String
  team      Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  createdBy String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  MANAGER
  SDR
  HR
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Lead {
  id              String @id @default(uuid())
  lead_identity   String
  assignment_info String

  lead_code    String?
  clinic_name  String?
  phone_number String?
  city         String?

  lead_type String?

  call_outcome   String?
  doctor_type    String?
  interest_level Int?
  call_notes     String?

  next_action_type      String? @default("New")
  whatsapp_details_sent Boolean @default(false)
  whatsapp_status       String  @default("Pending")
  next_action_date      String?
  last_call_date        String?
  touch_count           Int     @default(0)

  lead_status    String  @default("Active")
  priority_score Int     @default(0)
  overdue        Boolean @default(false)

  meeting_status Boolean @default(false)
  meeting_date   String?
  meeting_time   String?

  team_id       String?
  team          Team?     @relation(fields: [team_id], references: [id])
  manager_id    String?
  sdr_id        String?
  assigned_to   String?
  assigned_date String?
  meetings      Meeting[]
  logs          CallLog[]

  locked_by String?
  locked_at DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lead_status, sdr_id, priority_score])
  @@index([lead_status, team_id, priority_score])
  @@index([next_action_date])
}

model CallLog {
  id             String   @id @default(uuid())
  lead_id        String
  lead           Lead     @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  sdr_id         String
  sdr            User     @relation(fields: [sdr_id], references: [id], onDelete: Cascade)
  outcome        String
  doctor_type    String?
  interest_level Int?
  notes          String
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([sdr_id, createdAt])
}

model Meeting {
  id      String @id @default(uuid())
  lead_id String
  lead    Lead   @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  clinic_name  String?
  phone_number String?

  meeting_date   String
  meeting_time   String
  meeting_status String  @default("Scheduled")
  booked_by      String
  meeting_notes  String?
  no_show        Boolean @default(false)

  rescheduled_from String?
  rescheduled_to   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Candidate {
  id              String  @id @default(uuid())
  name            String
  phone_number    String  @unique
  email           String?
  interview_taken Boolean @default(false)
  status          String  @default("Applied")
  notes           String?
  hired_timing    String?
  scheduled_date  String?
  scheduled_time  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

